{
  "info": {
    "name": "Vehicle Rental Management System - Postman Collection",
    "_postman_id": "vrs-collection-2026",
    "description": "REST API Collection for College Mini-Project (Spring Boot + MySQL + AWS)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "BASE_URL",
      "value": "http://localhost:8080/api",
      "type": "string"
    },
    {
      "key": "TOKEN",
      "value": "jwt_token_sample",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rahul Sharma\",\n  \"email\": \"rahul@example.com\",\n  \"password\": \"password123\",\n  \"phone\": \"9123456789\",\n  \"role\": \"USER\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/auth/register",
              "host": ["{{BASE_URL}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@vehiclerental.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/auth/login",
              "host": ["{{BASE_URL}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Vehicles",
      "item": [
        {
          "name": "Get All Vehicles",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/vehicles",
              "host": ["{{BASE_URL}}"],
              "path": ["vehicles"]
            }
          }
        },
        {
          "name": "Get Vehicles by Type (CAR)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/vehicles?type=CAR",
              "host": ["{{BASE_URL}}"],
              "path": ["vehicles"],
              "query": [{"key": "type", "value": "CAR"}]
            }
          }
        },
        {
          "name": "Get Vehicle By ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/vehicles/1",
              "host": ["{{BASE_URL}}"],
              "path": ["vehicles", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Bookings",
      "item": [
        {
          "name": "Create Booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "2"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleId\": 1,\n  \"startDate\": \"2026-10-15\",\n  \"endDate\": \"2026-10-18\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/bookings",
              "host": ["{{BASE_URL}}"],
              "path": ["bookings"]
            }
          }
        },
        {
          "name": "Get My Bookings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "2"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/bookings/my",
              "host": ["{{BASE_URL}}"],
              "path": ["bookings", "my"]
            }
          }
        },
        {
          "name": "Cancel Booking",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-User-Id",
                "value": "2"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/bookings/1/cancel",
              "host": ["{{BASE_URL}}"],
              "path": ["bookings", "1", "cancel"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Admin Operations",
      "item": [
        {
          "name": "Get Dashboard Metrics",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/admin/dashboard",
              "host": ["{{BASE_URL}}"],
              "path": ["admin", "dashboard"]
            }
          }
        },
        {
          "name": "Update Booking Status",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CONFIRMED\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/admin/bookings/1/status",
              "host": ["{{BASE_URL}}"],
              "path": ["admin", "bookings", "1", "status"]
            }
          }
        }
      ]
    }
  ]
}
